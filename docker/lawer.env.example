# 复制为项目根目录 .env.docker 后填写；不要提交真实配置。
# 宿主机 MySQL 使用 host.docker.internal，并在 docker run 添加 --add-host。
# 远端 MySQL 使用实际地址；同一 Docker 网络的 MySQL 使用其容器名和内部端口。
# 与 Jiami 的 docker run -e 同名；mysql_root 表示登录用户名，不要求使用 root。
# 数据库需预先创建，使用 Lawer 独立库；密码按原文填写，无需 URL 编码。
mysql_ip=host.docker.internal
mysql_port=3306
mysql_root=law_workspace
mysql_password=REPLACE_WITH_MYSQL_PASSWORD
mysql_database=law_workspace
# 兼容旧 DATABASE_URL；两种配置同时存在时 DATABASE_URL 优先。
COOKIE_SECURE=true
DATA_DIR=/app/.local/files
CREWAI_TELEMETRY_ENABLED=false
CREWAI_TRACING_ENABLED=false
OTEL_SDK_DISABLED=true
