# 复制为项目根目录 .env.docker 后填写；不要提交真实配置。
# 宿主机 MySQL 使用 host.docker.internal，并在 docker run 添加 --add-host。
# 远端 MySQL 使用实际地址；同一 Docker 网络的 MySQL 使用其容器名和内部端口。
# 数据库需预先创建，使用 lawer 独立库；URL 中的用户名和密码需做 URL 编码。
DATABASE_URL=mysql+pymysql://law_workspace:REPLACE_WITH_URL_ENCODED_PASSWORD@host.docker.internal:3306/law_workspace?charset=utf8mb4
# 首次部署生成随机密钥；升级或迁移时必须沿用原 APP_SECRET。
APP_SECRET=REPLACE_WITH_RANDOM_SECRET
APP_USERNAME=admin
APP_PASSWORD=REPLACE_WITH_STRONG_LOGIN_PASSWORD
COOKIE_SECURE=true
DATA_DIR=/app/.local/files
CREWAI_TELEMETRY_ENABLED=false
CREWAI_TRACING_ENABLED=false
OTEL_SDK_DISABLED=true
